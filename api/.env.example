# GeoCluster API - environment template.
#
# Copy to api/.env and fill in real values. api/.env is gitignored; never commit
# it and never put a real key in this file (it is tracked).
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# Secrets are read server-side only and are never sent to the browser.

# ---- Secrets (leave empty when you do not have them) --------------------------
# AI assistant (Groq). Empty → /ai/chat answers 503 for questions; the offline
# glossary answers and the rule-based commands keep working.
GROQ_API_KEY=
# Older name for the same key, still read as a fallback (deprecated).
# FIREWORKS_API_KEY=

# Copernicus Data Space Ecosystem (Sentinel-2 imagery). Server-side only.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# ---- Browser origins allowed to call the API (comma-separated) ---------------
# The defaults cover the app on :8010 and the web/serve.py dev loop on :5173.
# Keep this to the origins you actually serve the frontend from. A deployment
# sets its single public origin here (no trailing slash, no wildcard).
ALLOWED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010,http://localhost:5173,http://127.0.0.1:5173

# ---- API surface -------------------------------------------------------------
# FastAPI's /docs, /redoc and /openapi.json. Set to false in production so the
# full route/parameter map is not published.
ENABLE_DOCS=true

# ---- Upload / processing limits (all optional; defaults shown) ---------------
# Images above this are downscaled with cv2.INTER_AREA.
MAX_IMAGE_MEGAPIXELS=4
# Maximum accepted upload size in megabytes.
MAX_UPLOAD_MB=15

# ---- Session policy (all optional; defaults shown) --------------------------
# Sliding session TTL in minutes.
SESSION_TTL_MINUTES=60
# Images kept per session; the least-recently-used image is evicted.
SESSION_MAX_IMAGES=6
# Global in-memory image budget across all sessions (megabytes).
GLOBAL_MEMORY_MB=512

# ---- Satellite (optional; defaults shown) -----------------------------------
# Cache folder for downloaded crops and place lookups. Anything under the OS
# temp directory is fine: the cache is disposable and is never served over HTTP.
# SATELLITE_CACHE_DIR=
# Hard maximum for a satellite crop, per side, in kilometres. Anything larger
# is rejected with a 422 (raise it only if you really need bigger crops).
SATELLITE_MAX_KM=5
# Copernicus request timeouts, in seconds: connect and read. A connection error or
# timeout is retried 3 times with a short backoff, then the request fails with a 502.
COPERNICUS_CONNECT_TIMEOUT_SECONDS=15
COPERNICUS_READ_TIMEOUT_SECONDS=90
# Nominatim (OpenStreetMap) requires a real identifying User-Agent; override it
# with your own contact URL if you run this for a long time.
# NOMINATIM_USER_AGENT=GeoCluster/2.0 (Sentinel-2 crop fetch; +https://example.org/contact)

# ---- Reverse proxy -----------------------------------------------------------
# Only set this to true when the app runs behind a proxy that OVERWRITES
# X-Forwarded-For (Render, Fly, nginx with proxy_set_header). It makes the rate
# limits charge the real visitor instead of the proxy; leaving it false locally
# is correct. A client-supplied header is never trusted: the last hop wins.
TRUST_FORWARDED_HEADERS=false

# ---- In-process rate limits (requests per minute, per client IP) ------------
# These are the free-tier guards for the two endpoints that spend quota or
# someone else's network. 0 disables a limit.
AI_RATE_LIMIT_PER_MINUTE=10
SATELLITE_RATE_LIMIT_PER_MINUTE=5
