# GeoCluster API — environment template.
# Copy to api/.env and fill in real values. Never commit .env (it is gitignored).

# Fireworks AI (LLM assistant). Server-side only; must never reach the browser.
FIREWORKS_API_KEY=

# Copernicus Data Space Ecosystem (Sentinel-2 imagery). Server-side only.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Browser origins allowed to call the API (comma-separated).
# Localhost-only by default.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8000

# ---- Upload / processing limits (all optional; defaults shown) ----
# Images above this are downscaled with cv2.INTER_AREA.
MAX_IMAGE_MEGAPIXELS=4
# Maximum accepted upload size in megabytes.
MAX_UPLOAD_MB=15

# ---- Session policy (all optional; defaults shown) ----
# Sliding session TTL in minutes.
SESSION_TTL_MINUTES=60
# Images kept per session; the least-recently-used image is evicted.
SESSION_MAX_IMAGES=6
# Global in-memory image budget across all sessions (megabytes).
GLOBAL_MEMORY_MB=512

# ---- Satellite (optional; defaults shown) ----
# Cache folder for downloaded crops and place lookups.
# SATELLITE_CACHE_DIR=/tmp/geocluster-satellite-cache
# Hard maximum for a satellite crop, per side, in kilometres. Anything larger
# is rejected with a 422 (raise it only if you really need bigger crops).
SATELLITE_MAX_KM=5
# Nominatim (OpenStreetMap) requires a real identifying User-Agent; override it
# with your own contact URL if you run this for a long time.
# NOMINATIM_USER_AGENT=GeoCluster/2.0 (Sentinel-2 crop fetch; +https://example.org/contact)

# ---- In-process rate limits (requests per minute, optional) ----
AI_RATE_LIMIT_PER_MINUTE=10
SATELLITE_RATE_LIMIT_PER_MINUTE=5
