# Freebuff agent metadata — never commit this
.freebuff/

# Environment and secrets. Real values never belong in git.
# The .env.example templates are placeholder names only and ARE tracked
# (they are un-ignored below).
.env
.env.*
api/.env
!.env.example
!api/.env.example
*.env.local
.envrc
*.pem
*.key
*.p12
*.pfx
id_rsa*

# Python
__pycache__/
*.py[cod]
*.pyc
venv/
.venv/
.pytest_cache/

# Node (only used by the optional jsdom boot test; the web frontend has no
# build step and no runtime dependencies)
node_modules/

# IDE and OS folders
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs
*.log

# Satellite download cache. The app writes it under the OS temp directory by
# default; this entry covers a cache folder configured inside the repository.
geocluster-satellite-cache/

# Regenerable runtime artifacts under the project's data dir.
# These are produced by the app/tests on every run (K-Means output files,
# processed images, satellite download cache) — do not commit them.
/GEOCLUSTER 2.0/data/cache/
/GEOCLUSTER 2.0/data/params.txt
/GEOCLUSTER 2.0/data/centroids.txt
/GEOCLUSTER 2.0/data/ranges.txt
/GEOCLUSTER 2.0/data/output.csv
/GEOCLUSTER 2.0/data/output_meta.txt
/GEOCLUSTER 2.0/data/huffman.bin
/GEOCLUSTER 2.0/data/test_huffman.bin
/GEOCLUSTER 2.0/data/*_sentinel.png
